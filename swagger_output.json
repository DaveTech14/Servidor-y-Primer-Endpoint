{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Inscripciones Académicas",
    "description": "Documentación de la API REST",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/estudiantes",
      "description": "Servidor Local - Estudiantes"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Obtener lista de estudiantes",
        "description": "Retorna todos los estudiantes registrados o filtrados por bootcamp.",
        "parameters": [
          {
            "name": "bootcamp",
            "in": "query",
            "description": "Filtrar estudiantes por nombre de bootcamp",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Registrar un nuevo estudiante",
        "description": "",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "David Salinas"
                  },
                  "email": {
                    "type": "string",
                    "example": "davosal@gmail.com"
                  },
                  "bootcamp": {
                    "type": "string",
                    "example": "fullstackPERN"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/{id}": {
      "get": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Obtener estudiante por ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID único del estudiante"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Actualizar datos de un estudiante",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del estudiante a actualizar"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "example": "any"
                  },
                  "email": {
                    "example": "any"
                  },
                  "bootcamp": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Estudiantes"
        ],
        "summary": "Eliminar un estudiante por ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID del estudiante a eliminar"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  }
}